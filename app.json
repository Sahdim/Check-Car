{
  "expo": {
    "name": "Check & Car",
    "slug": "check-and-car",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "checkandcar",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.checkandcar.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Check & Car utilise l'appareil photo pour photographier la carte grise du véhicule.",
        "NSPhotoLibraryUsageDescription": "Check & Car accède à tes photos pour choisir la photo de la carte grise."
      }
    },
    "android": {
      "package": "fr.checkandcar.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Check & Car accède à tes photos pour choisir la photo de la carte grise.",
          "cameraPermission": "Check & Car utilise l'appareil photo pour photographier la carte grise du véhicule."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}